.container { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #303133; margin-bottom: 24rpx; }
.empty { text-align: center; color: #909399; padding: 80rpx 0; }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.biz-type { font-size: 30rpx; font-weight: bold; color: #303133; }
.status { font-size: 24rpx; color: #E6A23C; }
.detail { font-size: 24rpx; color: #909399; margin-bottom: 16rpx; }
.actions { display: flex; gap: 16rpx; }
.btn-approve { background: #67C23A; color: #fff; }
.btn-reject { background: #F56C6C; color: #fff; }
