.container { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #303133; margin-bottom: 24rpx; }
.empty { text-align: center; color: #909399; padding: 80rpx 0; }
.item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.sub { font-size: 24rpx; color: #909399; }
.bill-no { font-size: 28rpx; font-weight: bold; color: #303133; }
.amount { font-size: 32rpx; color: #E6A23C; font-weight: bold; }
.status { font-size: 24rpx; color: #67C23A; }
